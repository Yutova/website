<IfModule mod_rewrite.c>
    RewriteEngine On

    # Always prefer the Yutova static website
    DirectoryIndex index.html

    # Allow real static files/directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # All other frontend routes go to the Yutova website
    RewriteRule ^ index.html [L]
</IfModule>